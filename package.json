{
  "name": "vibefy",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "pnpm -r --filter ./packages/** build && pnpm --filter @vibefy/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand:build": "tsx tools/brand-build.mts",
    "check:copy": "node tools/copy-lint.mjs",
    "check:secrets": "node tools/secret-scan.mjs",
    "check:contrast": "tsx tools/contrast-check.mts",
    "check:brand": "node tools/brand-check.mjs",
    "verify": "pnpm check:secrets && pnpm check:copy && pnpm check:contrast && pnpm check:brand && pnpm check:stubs && pnpm legal:registry && pnpm typecheck && pnpm test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:stubs": "node tools/stub-check.mjs",
    "tokens:build": "node tools/tokens-build.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "legal:registry": "node tools/legal-registry.mjs",
    "dev:worker": "pnpm --filter @vibefy/worker start",
    "badge:keygen": "tsx tools/generate-badge-key.mts"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@vibefy/badge": "workspace:*",
    "@vibefy/shared": "workspace:*",
    "pg": "8.23.0",
    "playwright": "^1.62.1",
    "prettier": "3.6.2",
    "sharp": "0.35.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
