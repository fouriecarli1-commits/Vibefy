{
  "$comment": "Single source of truth for the Vibefy palette. The web console, the report PDF and the badge SVG all read this file, so the three cannot drift. Every pair listed under contrastPairs is asserted by tools/contrast-check.mts in CI.",
  "brand": {
    "navy": "#16205A",
    "blue": "#1F5FE0",
    "azure": "#2E9BE0",
    "teal": "#2FD3C4",
    "ink": "#0B1230",
    "mist": "#F4F7FC"
  },
  "gradient": {
    "primary": "linear-gradient(135deg, #1F5FE0 0%, #2E9BE0 55%, #2FD3C4 100%)",
    "primaryStops": [
      {
        "color": "#1F5FE0",
        "offset": "0%"
      },
      {
        "color": "#2E9BE0",
        "offset": "55%"
      },
      {
        "color": "#2FD3C4",
        "offset": "100%"
      }
    ]
  },
  "$semanticComment": "border is a decorative divider and carries no contrast requirement; borderInteractive is the outline of anything a user can operate and must meet 3:1.",
  "semantic": {
    "light": {
      "surface": "#FFFFFF",
      "surfaceMuted": "#F4F7FC",
      "surfaceInverse": "#0B1230",
      "border": "#D5DEEF",
      "borderInteractive": "#7B85AD",
      "text": "#0B1230",
      "textMuted": "#5A6488",
      "textInverse": "#F4F7FC",
      "link": "#1F5FE0",
      "accent": "#1F5FE0",
      "accentDecorative": "#2FD3C4",
      "onAccent": "#FFFFFF",
      "success": "#0E7C74",
      "warning": "#8A4B08",
      "danger": "#B3261E",
      "focusRing": "#1F5FE0"
    },
    "dark": {
      "surface": "#0B1230",
      "surfaceMuted": "#141C40",
      "surfaceInverse": "#FFFFFF",
      "border": "#2A3465",
      "borderInteractive": "#6874B2",
      "text": "#F4F7FC",
      "textMuted": "#9AA6CC",
      "textInverse": "#0B1230",
      "link": "#7FD9F0",
      "accent": "#2E9BE0",
      "accentDecorative": "#2FD3C4",
      "onAccent": "#0B1230",
      "success": "#2FD3C4",
      "warning": "#F5C26B",
      "danger": "#FF9A92",
      "focusRing": "#7FD9F0"
    }
  },
  "badgeStatus": {
    "$comment": "A badge is never a broken image. Every non-active state renders as a distinct, legible 'not currently verified' mark.",
    "active": {
      "ring": "#1F5FE0",
      "accent": "#2FD3C4",
      "text": "#16205A",
      "label": "Verified"
    },
    "suspended": {
      "ring": "#8A4B08",
      "accent": "#C98A2E",
      "text": "#5C3205",
      "label": "Suspended"
    },
    "expired": {
      "ring": "#6B7280",
      "accent": "#9CA3AF",
      "text": "#374151",
      "label": "Expired"
    },
    "revoked": {
      "ring": "#B3261E",
      "accent": "#D9564E",
      "text": "#7A1912",
      "label": "Revoked"
    }
  },
  "contrastPairs": [
    {
      "fg": "light.text",
      "bg": "light.surface",
      "min": 4.5,
      "usage": "body text on white"
    },
    {
      "fg": "light.text",
      "bg": "light.surfaceMuted",
      "min": 4.5,
      "usage": "body text on mist panels"
    },
    {
      "fg": "light.textMuted",
      "bg": "light.surface",
      "min": 4.5,
      "usage": "secondary text on white"
    },
    {
      "fg": "light.textMuted",
      "bg": "light.surfaceMuted",
      "min": 4.5,
      "usage": "secondary text on mist panels"
    },
    {
      "fg": "light.link",
      "bg": "light.surface",
      "min": 4.5,
      "usage": "links on white"
    },
    {
      "fg": "light.link",
      "bg": "light.surfaceMuted",
      "min": 4.5,
      "usage": "links on mist panels"
    },
    {
      "fg": "light.onAccent",
      "bg": "light.accent",
      "min": 4.5,
      "usage": "primary button label"
    },
    {
      "fg": "light.success",
      "bg": "light.surface",
      "min": 4.5,
      "usage": "pass state text"
    },
    {
      "fg": "light.warning",
      "bg": "light.surface",
      "min": 4.5,
      "usage": "warning state text"
    },
    {
      "fg": "light.danger",
      "bg": "light.surface",
      "min": 4.5,
      "usage": "critical finding text"
    },
    {
      "fg": "light.borderInteractive",
      "bg": "light.surface",
      "min": 3.0,
      "usage": "input and control outlines on white — WCAG 1.4.11 non-text contrast"
    },
    {
      "fg": "light.borderInteractive",
      "bg": "light.surfaceMuted",
      "min": 3.0,
      "usage": "input and control outlines on mist panels"
    },
    {
      "fg": "light.focusRing",
      "bg": "light.surface",
      "min": 3.0,
      "usage": "focus indicator — WCAG 2.2 focus appearance"
    },
    {
      "fg": "dark.text",
      "bg": "dark.surface",
      "min": 4.5,
      "usage": "body text on ink"
    },
    {
      "fg": "dark.text",
      "bg": "dark.surfaceMuted",
      "min": 4.5,
      "usage": "body text on raised ink panels"
    },
    {
      "fg": "dark.textMuted",
      "bg": "dark.surface",
      "min": 4.5,
      "usage": "secondary text on ink"
    },
    {
      "fg": "dark.textMuted",
      "bg": "dark.surfaceMuted",
      "min": 4.5,
      "usage": "secondary text on raised ink panels"
    },
    {
      "fg": "dark.link",
      "bg": "dark.surface",
      "min": 4.5,
      "usage": "links on ink"
    },
    {
      "fg": "dark.onAccent",
      "bg": "dark.accent",
      "min": 4.5,
      "usage": "primary button label on dark"
    },
    {
      "fg": "dark.success",
      "bg": "dark.surface",
      "min": 4.5,
      "usage": "pass state text on dark"
    },
    {
      "fg": "dark.warning",
      "bg": "dark.surface",
      "min": 4.5,
      "usage": "warning state text on dark"
    },
    {
      "fg": "dark.danger",
      "bg": "dark.surface",
      "min": 4.5,
      "usage": "critical finding text on dark"
    },
    {
      "fg": "dark.borderInteractive",
      "bg": "dark.surface",
      "min": 3.0,
      "usage": "input and control outlines on ink — WCAG 1.4.11 non-text contrast"
    },
    {
      "fg": "dark.borderInteractive",
      "bg": "dark.surfaceMuted",
      "min": 3.0,
      "usage": "input and control outlines on raised ink panels"
    },
    {
      "fg": "dark.focusRing",
      "bg": "dark.surface",
      "min": 3.0,
      "usage": "focus indicator on dark"
    }
  ],
  "forbiddenAsBodyText": {
    "$comment": "Colours that must never be used for text on a light surface. Enforced by tools/contrast-check.mts so a future contributor cannot quietly reintroduce them.",
    "onLightSurface": ["brand.teal", "brand.azure"]
  }
}
