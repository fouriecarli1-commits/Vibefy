# ---------------------------------------------------------------------------
# VibefyCode environment. Copy to .env.local and fill in.
# NEVER commit a filled-in copy. tools/secret-scan.mjs will fail the build.
# ---------------------------------------------------------------------------

# --- Deployment identity ---------------------------------------------------
# The primary domain is vibefycode.com, registered 2026-09-24.
#
# NEXT_PUBLIC_SITE_URL is a full origin: scheme, host, optional port, and
# nothing else. `https://vibefycode.com` in production. A bare host or a value
# carrying a path is repaired by `originFrom` rather than trusted, but do not
# rely on that — the variable NAME has no such forgiveness, and a name this
# codebase does not read is silent.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only when the badges are served from a DIFFERENT hostname from the console.
# Left empty, every page and the console read the origin off the request, which
# is correct for one hostname and cannot go stale. It is an origin, never a path:
# this shipped as `http://localhost:3000/verify` and made every badge URL a 404,
# because the route is /a/[slug] and there is no /verify/a.
NEXT_PUBLIC_VERIFY_URL=
# NEXT_PUBLIC_BRAND_NAME and NEXT_PUBLIC_SUPPORT_EMAIL were here and nothing read
# either. The brand name is deliberately not configurable — the wordmark is
# exactly "Verified by VibefyCode" and a deployment that could rename it could
# extend it. The support address is real and needed (see docs/DOMAIN.md); it has
# no variable yet because nothing renders it yet, and a variable nothing reads is
# worse than an absent one: it reports success.

# Jurisdiction variant for legal + privacy copy.
# Read by NOTHING today. The copy has one baseline and tools/legal-registry.mjs
# writes it as `jurisdictionBaseline: "gdpr"`; the swap layer the brief asks for
# is not built. Kept because this is the shape that layer will take.
VIBEFYCODE_JURISDICTION=gdpr

# --- Supabase --------------------------------------------------------------
# Local values are printed by `supabase start`. Production values live in the
# platform secret store, never here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY was here and nothing reads it. It is removed rather
# than kept: the console reaches the database through SUPABASE_DB_URL under the
# caller's own identity (apps/web/lib/sql.ts says why), so telling a deployment
# to paste a key that bypasses every policy, for nothing to use, is handing out a
# credential in exchange for no capability.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Assessment runner -----------------------------------------------------
# Overrides where Playwright looks for its browser. Set this in the runner
# container image; leave it empty locally and Playwright resolves it itself.
VIBEFYCODE_BROWSER_EXECUTABLE=

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=
# Hard ceilings. A runaway agent loop must not be able to generate an unbounded
# bill — and these four are NOT where that is enforced. The live ceilings are in
# config/pricing.json under `ceilings`, read by packages/governance/src/spend.ts,
# which is what pauses the queue. These are documentation of the numbers that
# apply; changing them here changes nothing. Left in because a reader looking for
# "what is the cap" looks in this file first, and finding nothing was worse.
VIBEFYCODE_MAX_COST_PER_RUN_USD=5.00
VIBEFYCODE_MAX_FREE_TIER_COST_PER_ACCOUNT_MONTH_USD=2.00
VIBEFYCODE_GLOBAL_DAILY_SPEND_CAP_USD=200.00
VIBEFYCODE_FREE_TIER_WEEKLY_BUDGET_ALERT_USD=100.00

# --- Stripe ----------------------------------------------------------------
# Without these the console says payments are not configured, and the webhook
# route falls back to a fake provider that still verifies signatures with a real
# HMAC. Production refuses to start without them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY was here and nothing reads it. Checkout is a
# server-side redirect to a Stripe-hosted page, so no card field ever exists in
# our own document — which is the arrangement SEC-12 exists to check for in other
# people's applications, and we are not going to fail our own criterion.
# Stripe price ids, one per plan in config/pricing.json.
STRIPE_PRICE_ONE_OFF=
STRIPE_PRICE_CERTIFIED=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_ORGANISATION=

# Paystack — South African customers, billed in rands.
#
# Paystack signs its webhooks with the secret key itself, so there is no
# separate webhook secret to set. The plan codes are created in the Paystack
# dashboard and are only needed for the recurring tiers; a one-off report needs
# no plan. Rand prices are not set here — they are decisions, and they live in
# config/pricing.json beside the dollar ones.
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CERTIFIED=
PAYSTACK_PLAN_AGENCY=

# --- Reports ---------------------------------------------------------------
# Where rendered reports are stored. Local disk in development; an object
# storage bucket in production — see docs/OPEN_ITEMS.md.
VIBEFYCODE_REPORT_DIR=.tmp/reports

# --- Badge signing ---------------------------------------------------------
# Ed25519 private key, PKCS#8 DER, base64-encoded. Generate with
# `pnpm badge:keygen`, which writes to stdout and never to a file. Store it ONLY
# in the platform secret store. If it leaks, every badge becomes forgeable.
#
# Only the worker needs these. The console deliberately never holds a signing
# key: every instance that could sign is another place it can leak from.
VIBEFYCODE_BADGE_SIGNING_KEY_B64=
VIBEFYCODE_BADGE_KEY_ID=
# Public JWKs of retired keys, as a JSON array. They stay published forever —
# removing one silently breaks every badge it ever signed.
VIBEFYCODE_BADGE_RETIRED_KEYS=

# --- Email (M2) ------------------------------------------------------------
RESEND_API_KEY=
# Signs the bounce and complaint webhook. Without it POST /api/email/webhook
# answers 404 rather than accepting unverified payloads. See docs/RUNBOOK.md.
RESEND_WEBHOOK_SECRET=
# The sending identity. `VIBEFYCODE_EMAIL_FROM` was the name in this file and
# ALERT_EMAIL_FROM is the name the code reads (packages/notify/src/resend.ts), so
# a deployment that followed this file exactly configured a key with no sender
# and the worker logged "email is not configured" and sent nothing. The same
# class of defect as a variable that does not exist, shipped in our own example.
ALERT_EMAIL_FROM="VibefyCode <alerts@vibefycode.com>"
ALERT_EMAIL_REPLY_TO=support@vibefycode.com

# --- Observability ---------------------------------------------------------
# SENTRY_DSN and NEXT_PUBLIC_SENTRY_DSN were here and nothing reads them: no
# Sentry client is installed and no error is reported anywhere. Removed rather
# than kept, because two set variables and no error reporting reads, from the
# outside, exactly like error reporting that is working. On docs/OPEN_ITEMS.md.
